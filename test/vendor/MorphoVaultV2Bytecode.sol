    /**
     * @notice Deploys a real Morpho Vault V2
     * @param owner The vault owner (can set the curator, sentinels, name and symbol)
     * @param asset The underlying ERC20
     * @return vault The address of the deployed VaultV2
     */
    function deploy(address owner, address asset) external returns (address vault) {
        bytes memory code = abi.encodePacked(VAULT_V2_INITCODE, abi.encode(owner, asset));
        assembly ("memory-safe") {
            vault := create(0, add(code, 0x20), mload(code))
        }
        require(vault != address(0), "VaultV2 deployment failed");
    }
}

